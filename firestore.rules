rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Permitir lectura pública de técnicos para el listado de marcación
    match /technicians/{tech} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Permitir lectura y escritura pública de asistencia para poder marcar
    match /attendances/{attendance} {
      allow read, write: if true;
    }

    // Por defecto, requerir autenticación para el resto de colecciones (usuarios, sedes, etc.)
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}